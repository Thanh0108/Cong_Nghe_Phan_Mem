@model QuanLyBanDoAnNhanh.Models.Product

@{
    ViewData["Title"] = Model.Name + " - Chi tiết món ăn";
    var averageRating = Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0;
    var reviewCount = Model.Reviews.Count();
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="#">@Model.Category?.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Product Image -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-lg overflow-hidden sticky-top" style="top: 20px;">
                <img src="@Model.ImageUrl" class="img-fluid w-100" alt="@Model.Name" style="object-fit: cover; min-height: 450px;">
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-md-6">
            <div class="ps-lg-4">
                <span class="badge bg-soft-orange text-orange mb-2 px-3 py-2 rounded-pill">@Model.Category?.Name</span>
                <h1 class="fw-bold mb-2">@Model.Name</h1>
                
                <!-- Ratings Summary -->
                <div class="d-flex align-items-center mb-4">
                    <div class="text-warning me-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(averageRating))
                            {
                                <i class="fas fa-star"></i>
                            }
                            else
                            {
                                <i class="far fa-star"></i>
                            }
                        }
                    </div>
                    <span class="text-muted small">(@averageRating.ToString("0.0") / 5.0 - @reviewCount đánh giá)</span>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <h2 class="text-orange fw-bold me-3 mb-0">@Model.Price.ToString("N0")đ</h2>
                    <span class="text-muted text-decoration-line-through">@( (Model.Price * 1.2m).ToString("N0") )đ</span>
                </div>

                <div class="product-description mb-4">
                    <h5 class="fw-bold mb-3">Mô tả sản phẩm</h5>
                    <p class="text-muted lead">
                        @Model.Description
                    </p>
                </div>

                <hr class="my-4">

                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    
                    <div class="row g-3 align-items-center mb-4">
                        <div class="col-auto">
                            <label class="fw-bold">Số lượng:</label>
                        </div>
                        <div class="col-auto">
                            <div class="input-group" style="width: 140px;">
                                <button class="btn btn-outline-secondary" type="button" onclick="changeQty(-1)">-</button>
                                <input type="number" name="quantity" id="quantity" class="form-control text-center fw-bold" value="1" min="1">
                                <button class="btn btn-outline-secondary" type="button" onclick="changeQty(1)">+</button>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex">
                        <button type="submit" class="btn btn-orange btn-lg px-5 py-3 rounded-pill fw-bold shadow-orange w-100">
                            <i class="fas fa-shopping-cart me-2"></i> THÊM VÀO GIỎ HÀNG
                        </button>
                    </div>
                </form>

                <div class="mt-5 grid row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-lg border-start border-orange border-4 h-100">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-truck text-orange me-2"></i>
                                <span class="fw-bold small">Giao hàng nhanh</span>
                            </div>
                            <p class="x-small text-muted mb-0">30-45 phút nội thành.</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-lg border-start border-success border-4 h-100">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <span class="fw-bold small">Đảm bảo vệ sinh</span>
                            </div>
                            <p class="x-small text-muted mb-0">Nguyên liệu tươi sạch.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="row mt-5 pt-5">
        <div class="col-12">
            <ul class="nav nav-tabs border-0 mb-4 justify-content-center" id="productTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold px-4 py-3 rounded-pill border-0 shadow-sm me-3" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
                        Đánh giá khách hàng (@reviewCount)
                    </button>
                </li>
            </ul>
            
            <div class="tab-content" id="productTabContent">
                <div class="tab-pane fade show active" id="reviews" role="tabpanel">
                    <div class="row">
                        <!-- Review Form -->
                        <div class="col-md-5 mb-5">
                            <div class="card border-0 shadow-sm rounded-lg p-4 bg-light">
                                <h4 class="fw-bold mb-4">Gửi đánh giá của bạn</h4>
                                <form asp-action="AddReview" method="post">
                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Họ tên của bạn</label>
                                        <input type="text" name="userName" class="form-control border-0 shadow-sm" placeholder="Nhập tên của bạn" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Xếp hạng (Sao)</label>
                                        <div class="star-rating">
                                            <input type="radio" id="star5" name="rating" value="5" /><label for="star5" title="5 sao">5 <i class="fas fa-star"></i></label>
                                            <input type="radio" id="star4" name="rating" value="4" /><label for="star4" title="4 sao">4 <i class="fas fa-star"></i></label>
                                            <input type="radio" id="star3" name="rating" value="3" /><label for="star3" title="3 sao">3 <i class="fas fa-star"></i></label>
                                            <input type="radio" id="star2" name="rating" value="2" /><label for="star2" title="2 sao">2 <i class="fas fa-star"></i></label>
                                            <input type="radio" id="star1" name="rating" value="1" checked /><label for="star1" title="1 sao">1 <i class="fas fa-star"></i></label>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Nhận xét</label>
                                        <textarea name="comment" class="form-control border-0 shadow-sm" rows="4" placeholder="Chia sẻ cảm nhận của bạn về món ăn..." required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-orange w-100 py-3 rounded-pill fw-bold shadow-orange">
                                        GỬI ĐÁNH GIÁ
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Review List -->
                        <div class="col-md-7">
                            @if (!Model.Reviews.Any())
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-comment-slash fa-3x text-light mb-3"></i>
                                    <p class="text-muted">Chưa có đánh giá nào cho món ăn này. Hãy là người đầu tiên đánh giá!</p>
                                </div>
                            }
                            else
                            {
                                <div class="review-list">
                                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                                    {
                                        <div class="card border-0 shadow-sm rounded-lg mb-4 p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar bg-orange text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                                        @review.UserName.Substring(0, 1).ToUpper()
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold mb-0">@review.UserName</h6>
                                                        <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                                    </div>
                                                </div>
                                                <div class="text-warning">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= review.Rating)
                                                        {
                                                            <i class="fas fa-star"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="far fa-star"></i>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            <p class="text-muted mb-0">
                                                @review.Comment
                                            </p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --orange: #ff5e00;
        --orange-hover: #e65500;
    }
    .bg-soft-orange { background-color: rgba(255, 94, 0, 0.1); }
    .text-orange { color: var(--orange); }
    .bg-orange { background-color: var(--orange); }
    .btn-orange { background-color: var(--orange); border: none; color: white; transition: 0.3s; }
    .btn-orange:hover { background-color: var(--orange-hover); color: white; transform: translateY(-2px); }
    .border-orange { border-color: var(--orange) !important; }
    .rounded-lg { border-radius: 1.25rem; }
    .shadow-orange { box-shadow: 0 10px 20px rgba(255, 94, 0, 0.2); }
    .breadcrumb-item a { color: #6c757d; text-decoration: none; }
    .breadcrumb-item.active { color: var(--orange); font-weight: 600; }
    .x-small { font-size: 0.75rem; }
    
    /* Star Rating Input */
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
    }
    .star-rating input { display: none; }
    .star-rating label {
        cursor: pointer;
        padding: 5px 10px;
        background: #fff;
        border: 1px solid #ddd;
        margin-right: 5px;
        border-radius: 5px;
        transition: 0.2s;
    }
    .star-rating input:checked + label,
    .star-rating label:hover {
        background: var(--orange);
        color: white;
        border-color: var(--orange);
    }

    .nav-tabs .nav-link { color: #6c757d; background: #f8f9fa; }
    .nav-tabs .nav-link.active { background: white !important; color: var(--orange) !important; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
    
    .avatar { font-weight: bold; font-size: 1.2rem; }
</style>

@section Scripts {
    <script>
        function changeQty(val) {
            let qty = document.getElementById('quantity');
            let newVal = parseInt(qty.value) + val;
            if (newVal >= 1) {
                qty.value = newVal;
            }
        }
    </script>
}

