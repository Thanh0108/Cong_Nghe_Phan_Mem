@model QuanLyBanDoAnNhanh.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="account-page">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card account-card shadow-lg border-0 rounded-4 overflow-hidden">
                    <!-- Header -->
                    <div class="card-header bg-gradient-orange text-white text-center py-4">
                        <div class="mb-2">
                            <i class="fas fa-user-plus fa-3x"></i>
                        </div>
                        <h3 class="fw-bold mb-1">Đăng ký tài khoản</h3>
                        <p class="mb-0 opacity-75">Tham gia FastBite để nhận ưu đãi!</p>
                    </div>

                    <div class="card-body p-4">
                        <form asp-action="Register" method="post">
                            @Html.AntiForgeryToken()

                            <div class="row">
                                <!-- Họ tên -->
                                <div class="col-12 mb-3">
                                    <label asp-for="FullName" class="form-label fw-semibold">
                                        <i class="fas fa-user text-orange me-1"></i> Họ và tên
                                    </label>
                                    <input asp-for="FullName" class="form-control form-control-lg rounded-3" 
                                           placeholder="Nhập họ và tên" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <!-- Email -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label fw-semibold">
                                        <i class="fas fa-envelope text-orange me-1"></i> Email
                                    </label>
                                    <input asp-for="Email" class="form-control form-control-lg rounded-3" 
                                           placeholder="your@email.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <!-- Số điện thoại -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Phone" class="form-label fw-semibold">
                                        <i class="fas fa-phone text-orange me-1"></i> Số điện thoại
                                    </label>
                                    <input asp-for="Phone" class="form-control form-control-lg rounded-3" 
                                           placeholder="0xxx xxx xxx" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <!-- Địa chỉ -->
                                <div class="col-12 mb-3">
                                    <label asp-for="Address" class="form-label fw-semibold">
                                        <i class="fas fa-map-marker-alt text-orange me-1"></i> Địa chỉ (không bắt buộc)
                                    </label>
                                    <input asp-for="Address" class="form-control form-control-lg rounded-3" 
                                           placeholder="Nhập địa chỉ giao hàng" />
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>

                                <!-- Mật khẩu -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Password" class="form-label fw-semibold">
                                        <i class="fas fa-lock text-orange me-1"></i> Mật khẩu
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="Password" class="form-control form-control-lg rounded-start-3" 
                                               placeholder="Ít nhất 6 ký tự" id="passwordInput" />
                                        <button class="btn btn-outline-secondary rounded-end-3" type="button" 
                                                onclick="togglePassword('passwordInput', 'toggleIcon1')">
                                            <i class="fas fa-eye" id="toggleIcon1"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <!-- Xác nhận mật khẩu -->
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                        <i class="fas fa-lock text-orange me-1"></i> Xác nhận mật khẩu
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="ConfirmPassword" class="form-control form-control-lg rounded-start-3" 
                                               placeholder="Nhập lại mật khẩu" id="confirmPasswordInput" />
                                        <button class="btn btn-outline-secondary rounded-end-3" type="button" 
                                                onclick="togglePassword('confirmPasswordInput', 'toggleIcon2')">
                                            <i class="fas fa-eye" id="toggleIcon2"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Submit -->
                            <div class="d-grid mt-3">
                                <button type="submit" class="btn btn-orange btn-lg text-white fw-bold rounded-3 py-3">
                                    <i class="fas fa-user-plus me-2"></i>ĐĂNG KÝ
                                </button>
                            </div>
                        </form>

                        <!-- Divider -->
                        <div class="text-center my-4">
                            <span class="text-muted">─────── hoặc ───────</span>
                        </div>

                        <!-- Link to Login -->
                        <div class="text-center">
                            <p class="mb-0">Đã có tài khoản?
                                <a asp-action="Login" class="text-orange fw-bold text-decoration-none">
                                    Đăng nhập ngay <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}

<style>
    .bg-gradient-orange {
        background: linear-gradient(135deg, #ff5e00 0%, #ff8c42 100%);
    }
    .account-card {
        transition: transform 0.3s ease;
    }
    .account-card:hover {
        transform: translateY(-5px);
    }
    .form-control:focus {
        border-color: #ff5e00;
        box-shadow: 0 0 0 0.2rem rgba(255, 94, 0, 0.15);
    }
    .btn-orange {
        background: linear-gradient(135deg, #ff5e00 0%, #ff8c42 100%);
        border: none;
        transition: all 0.3s ease;
    }
    .btn-orange:hover {
        background: linear-gradient(135deg, #e65500 0%, #ff7a30 100%);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 94, 0, 0.3);
    }
    .text-orange {
        color: #ff5e00 !important;
    }
</style>
