@model IEnumerable<QuanLyBanDoAnNhanh.Models.Product>

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary font-weight-bold">Quản Lý Sản Phẩm</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Giá</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4">
                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded shadow-sm" style="width: 60px; height: 60px; object-fit: cover;">
                            </td>
                            <td>
                                <div class="font-weight-bold text-dark">@item.Name</div>
                                <small class="text-muted text-truncate d-block" style="max-width: 200px;">@item.Description</small>
                            </td>
                            <td>
                                <span class="badge bg-soft-primary text-primary rounded-pill px-3">@item.Category?.Name</span>
                            </td>
                            <td class="font-weight-bold text-orange">
                                @item.Price.ToString("N0")đ
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-info me-1" title="Sửa"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-soft-primary { background-color: rgba(121, 40, 202, 0.1); }
    .text-orange { color: #ff5e00; }
    .table thead th { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; border-top: none; }
    .rounded-lg { border-radius: 1rem; }
</style>
