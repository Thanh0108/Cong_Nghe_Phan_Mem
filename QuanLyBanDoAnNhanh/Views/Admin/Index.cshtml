@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4 text-primary font-weight-bold">Quản Trị Hệ Thống</h2>
        </div>
    </div>

    <div class="row">
        <!-- Stats Cards -->
        <div class="col-xl-4 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
                <div class="card-body p-3">
                    <div class="row">
                        <div class="col-8">
                            <div class="numbers">
                                <p class="text-sm mb-0 text-uppercase font-weight-bold">Tổng Sản Phẩm</p>
                                <h3 class="font-weight-bolder">@ViewBag.ProductCount</h3>
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div class="icon icon-shape bg-gradient-primary shadow-primary text-center rounded-circle">
                                <i class="fas fa-hamburger text-lg opacity-10" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
                <div class="card-body p-3">
                    <div class="row">
                        <div class="col-8">
                            <div class="numbers">
                                <p class="text-sm mb-0 text-uppercase font-weight-bold">Khách Hàng</p>
                                <h3 class="font-weight-bolder">@ViewBag.UserCount</h3>
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div class="icon icon-shape bg-gradient-danger shadow-danger text-center rounded-circle">
                                <i class="fas fa-users text-lg opacity-10" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-6 mb-4">
            <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
                <div class="card-body p-3">
                    <div class="row">
                        <div class="col-8">
                            <div class="numbers">
                                <p class="text-sm mb-0 text-uppercase font-weight-bold">Danh Mục</p>
                                <h3 class="font-weight-bolder">@ViewBag.CategoryCount</h3>
                            </div>
                        </div>
                        <div class="col-4 text-end">
                            <div class="icon icon-shape bg-gradient-success shadow-success text-center rounded-circle">
                                <i class="fas fa-list text-lg opacity-10" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">Công Cụ Quản Lý</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <a asp-action="Products" class="btn btn-outline-primary btn-lg w-100 py-4 shadow-sm border-2">
                                <i class="fas fa-box-open mb-2 d-block fa-2x"></i>
                                Quản Lý Sản Phẩm
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a asp-action="Users" class="btn btn-outline-info btn-lg w-100 py-4 shadow-sm border-2">
                                <i class="fas fa-user-shield mb-2 d-block fa-2x"></i>
                                Quản Lý Người Dùng
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a href="/" class="btn btn-outline-secondary btn-lg w-100 py-4 shadow-sm border-2">
                                <i class="fas fa-home mb-2 d-block fa-2x"></i>
                                Xem Trang Chủ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary { background: linear-gradient(310deg, #7928ca 0%, #ff0080 100%); }
    .bg-gradient-danger { background: linear-gradient(310deg, #ea0606 0%, #ff667c 100%); }
    .bg-gradient-success { background: linear-gradient(310deg, #17ad37 0%, #98ec2d 100%); }
    .icon-shape {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }
    .card { transition: transform 0.2s; }
    .card:hover { transform: translateY(-5px); }
    .btn-lg { border-radius: 15px; font-weight: 600; }
</style>
