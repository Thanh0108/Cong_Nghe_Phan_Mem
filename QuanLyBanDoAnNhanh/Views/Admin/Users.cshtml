@model IEnumerable<QuanLyBanDoAnNhanh.Models.User>

@{
    ViewData["Title"] = "Quản Lý Người Dùng";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary font-weight-bold">Quản Lý Người Dùng</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Họ và tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Vai trò</th>
                            <th>Ngày tạo</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm me-3 bg-gradient-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        @item.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="font-weight-bold">@item.FullName</div>
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>
                                @if (item.Role == "Admin") {
                                    <span class="badge bg-danger rounded-pill px-3">Admin</span>
                                } else {
                                    <span class="badge bg-secondary rounded-pill px-3">Customer</span>
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-info me-1" title="Xem chi tiết" onclick="viewOrders(@item.Id, '@item.FullName')"><i class="fas fa-eye"></i></button>
                                @if (item.Role != "Admin") {
                                    <button class="btn btn-sm btn-outline-danger" title="Khóa tài khoản"><i class="fas fa-user-lock"></i></button>
                                }
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Orders Modal -->
<div class="modal fade" id="ordersModal" tabindex="-1" aria-labelledby="ordersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="ordersModalLabel">Lịch sử đặt hàng - <span id="modalUserName"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div id="ordersLoading" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                <div id="ordersContent">
                    <!-- Orders will be loaded here -->
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0 pt-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewOrders(userId, userName) {
            // Set modal title
            document.getElementById('modalUserName').textContent = userName;
            
            // Show modal and loading state
            var myModal = new bootstrap.Modal(document.getElementById('ordersModal'));
            myModal.show();
            
            document.getElementById('ordersLoading').classList.remove('d-none');
            document.getElementById('ordersContent').innerHTML = '';

            // Fetch orders
            fetch(`/Admin/GetUserOrders/${userId}`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('ordersLoading').classList.add('d-none');
                    const content = document.getElementById('ordersContent');
                    
                    if (data.length === 0) {
                        content.innerHTML = `
                            <div class="text-center text-muted py-5">
                                <i class="fas fa-box-open fa-3x mb-3 text-black-50"></i>
                                <h5>Khách hàng này chưa có đơn hàng nào.</h5>
                            </div>
                        `;
                        return;
                    }

                    let html = '';
                    data.forEach(order => {
                        let statusClass = order.status === 'Pending' ? 'bg-warning text-dark' : 'bg-success text-white';
                        let statusText = order.status === 'Pending' ? 'Đang xử lý' : order.status;

                        let detailsHtml = order.details.map(d => `
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <span class="fw-bold text-dark">${d.productName}</span>
                                    <small class="text-muted ms-2">x${d.quantity}</small>
                                </div>
                                <span class="text-orange fw-bold">${(d.unitPrice * d.quantity).toLocaleString('vi-VN')}đ</span>
                            </div>
                        `).join('');

                        html += `
                            <div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden">
                                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-primary"><i class="fas fa-receipt me-2"></i>Đơn hàng #${order.id}</span>
                                        <span class="badge ${statusClass} rounded-pill px-3 py-2">${statusText}</span>
                                    </div>
                                    <small class="text-muted"><i class="far fa-clock me-1"></i>${order.orderDate}</small>
                                </div>
                                <div class="card-body">
                                    ${detailsHtml}
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                        <span class="fw-bold text-muted">Tổng cộng:</span>
                                        <span class="fs-5 fw-bold text-danger">${order.totalAmount.toLocaleString('vi-VN')}đ</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    
                    content.innerHTML = html;
                })
                .catch(error => {
                    document.getElementById('ordersLoading').classList.add('d-none');
                    document.getElementById('ordersContent').innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle me-2"></i>Đã có lỗi xảy ra khi tải dữ liệu đơn hàng.
                        </div>
                    `;
                    console.error('Error fetching orders:', error);
                });
        }
    </script>
}

<style>
    .bg-gradient-primary { background: linear-gradient(310deg, #7928ca 0%, #ff0080 100%); }
    .avatar-sm { font-weight: bold; font-size: 1.1rem; }
    .table thead th { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; border-top: none; }
    .rounded-lg { border-radius: 1rem; }
</style>
